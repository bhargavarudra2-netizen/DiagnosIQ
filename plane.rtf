\fs30 \cf6 \cb5 \strokec6 4.1 The Hybrid Architecture\
\pard\pardeftab720\sa400\partightenfactor0

\fs32 \cf4 \strokec4 The safety system has two layers working in sequence:\
Layer 1 \'97 Deterministic Rule Engine (Python)\cb1 \uc0\u8232 \cb5 Fast, explicit threshold checks that run on the parsed JSON\'a0
\f4\i before
\f0\i0 \'a0it reaches the frontend. No AI ambiguity here \'97 these are hard-coded medical thresholds.\
\pard\pardeftab720\partightenfactor0

\fs24 \cf4 \cb5 \strokec4 # Example rule definitions\
EMERGENCY_RULES = \{\
    "glucose":        \{"critical_high": 500,  "unit": "mg/dL", "condition": "Hyperglycaemic crisis"\},\
    "troponin":       \{"critical_high": 2.0,  "unit": "ng/mL", "condition": "Possible cardiac event"\},\
    "haemoglobin":    \{"critical_low": 6.0,   "unit": "g/dL",  "condition": "Severe anaemia"\},\
    "creatinine":     \{"critical_high": 10.0, "unit": "mg/dL", "condition": "Renal failure risk"\},\
    "potassium":      \{"critical_high": 6.5,  "unit": "mEq/L", "condition": "Hyperkalaemia \'97 cardiac risk"\},\
    "sodium":         \{"critical_low": 120,   "unit": "mEq/L", "condition": "Severe hyponatraemia"\},\
    "ldl":            \{"high": 190,           "unit": "mg/dL", "condition": "Very high cardiovascular risk"\},\
\}\
\
def check_emergency_flags(biomarkers: list) -> list[EmergencyFlag]:\
    flags = []\
    for marker in biomarkers:\
        rule = EMERGENCY_RULES.get(marker.name.lower())\
        if rule:\
            if "critical_high" in rule and marker.value > rule["critical_high"]:\
                flags.append(EmergencyFlag(\
                    marker=marker.name,\
                    value=marker.value,\
                    condition=rule["condition"],\
                    severity="CRITICAL",\
                    action="Seek immediate medical attention. Do not wait."\
                ))\
    return flags\
\
\pard\pardeftab720\sa400\partightenfactor0

